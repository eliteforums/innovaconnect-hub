# Public URL of the deployed site (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://innovahack.eliteforums.in

# Optional Google Search Console ownership token (HTML tag verification).
GOOGLE_SITE_VERIFICATION=

# ── Admin dashboard (/admin) ─────────────────────────────────────────
# Defaults to admin / admin. CHANGE THESE before the site is public —
# the dashboard can edit every page and shows all form submissions.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Default registration state (announcement | interest | soon | open | closed).
# Once you change it in the dashboard (Event settings), the dashboard wins.
REGISTRATION_STATUS=interest

# Default for hiding articles still marked `draft: true` (also editable in the dashboard).
HIDE_DRAFT_ARTICLES=false

# ── Storage (choose one) ──────────────────────────────────────────────
# Supabase / PostgreSQL via PostgREST. Server-side only — never expose the secret key.
SUPABASE_URL=
# Preferred elevated key from Project Settings → API Keys (sb_secret_...).
SUPABASE_SECRET_KEY=
# Legacy service_role key is also supported while migrating existing deployments.
SUPABASE_SERVICE_ROLE_KEY=
# …or newline-delimited JSON files on a persistent disk (self-hosting only).
# STORAGE_DRIVER=file
# LOCAL_STORE_DIR=/var/lib/innovahack
# Without either, production refuses submissions with an honest 503.

# ── Email (optional, via Resend) ─────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="InnovaHack <updates@example.com>"
# Receives a notification for every stored submission.
NOTIFY_EMAIL=
